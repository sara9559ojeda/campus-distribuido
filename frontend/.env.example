# CampusAlert Frontend — Environment Variables Template
# Copy this file to .env and fill in your values.
# Do NOT commit .env to source control.

# ── API ────────────────────────────────────────
# API Gateway base URL (no trailing slash)
VITE_API_URL=http://localhost:3001

# ── WebSocket ──────────────────────────────────
# Notification Service WebSocket endpoint
VITE_WS_URL=ws://localhost:3003/ws

# ── MQTT (display only) ────────────────────────
# Shown in UI — actual MQTT connection is server-side
VITE_MQTT_HOST=localhost
VITE_MQTT_PORT=1883

# ── Polling intervals ──────────────────────────
# Analytics service polling interval (ms)
VITE_ANALYTICS_INTERVAL=10000

# System health check polling interval (ms)
VITE_HEALTH_INTERVAL=10000
